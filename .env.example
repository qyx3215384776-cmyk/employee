# Kimi (Moonshot AI) — OpenAI-compatible API, used by Tab1 Agent for natural-language parsing.
# Server-side only; never exposed to the browser. Copy this file to .env.local and fill in your key.

MOONSHOT_API_KEY=

# Optional overrides (defaults shown):
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1   # or https://api.moonshot.ai/v1 for the international endpoint
# MOONSHOT_MODEL=kimi-k3
